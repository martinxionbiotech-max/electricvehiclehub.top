# =============================================================================
# China EV Mart - Environment Variables
# Copy this file to .env and fill in your values.
# For Cloudflare Pages: set these as environment variables in the dashboard.
# =============================================================================

# -----------------------------------------------------------------------------
# Site Configuration (Required)
# -----------------------------------------------------------------------------

# The canonical URL of your site (used for SEO, sitemaps, and RSS feeds)
SITE_URL=https://chinaevmart.com

# Your site/brand name (displayed in header, footer, and meta tags)
SITE_NAME=China EV Mart

# Site description for SEO and meta tags
SITE_DESCRIPTION=An independent information platform for discovering Chinese new-energy vehicles, comparing vehicle specifications, researching automotive technology, and evaluating export-market requirements.

# Author name for meta tags and copyright
SITE_AUTHOR=Wei Wang
