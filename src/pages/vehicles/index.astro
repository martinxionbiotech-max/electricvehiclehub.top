---
import { getCollection } from 'astro:content';
import { brandLabelMap } from '@/lib/brand-label';
import MarketingLayout from '@/layouts/MarketingLayout.astro';
import { POWERTRAIN_ORDER, powertrainLabel } from '@/lib/powertrain';

const vehicles = await getCollection('vehicles');
const brands = await getCollection('brands');
const brandMap = await brandLabelMap();
vehicles.sort((a, b) => a.data.price_usd - b.data.price_usd);

// 公开计数从规范化数据集实时推导
const vehicleCount = vehicles.length;
const brandCount = brands.length;

// 动力形式按规范枚举顺序（BEV/PHEV/EREV/HEV/ICE），仅呈现数据中存在的
const powertrains = POWERTRAIN_ORDER.filter((p) => vehicles.some((v) => v.data.powertrain === p));
const bodyTypes = [...new Set(vehicles.map((v) => v.data.type))].sort();

// 客户端过滤数据（含完整显示字段）
const items = vehicles.map((v) => ({
  slug: v.data.slug,
  title: v.data.title,
  brand: v.data.brand.toUpperCase(),
  brandLabel: brandMap.get(v.data.brand) || v.data.brand,
  type: v.data.type,
  powertrain: v.data.powertrain,
  price: v.data.price_usd,
  range: v.data.range_cltc_km,
  image: v.data.image,
  description: v.data.description,
}));
const itemsJson = JSON.stringify(items).replace(/</g, '\\u003c');
---

<MarketingLayout
  title="Chinese New-Energy Vehicle Database"
  description={`Browse ${vehicleCount} Chinese new-energy vehicles across ${brandCount} brands. Prices are China ex-factory reference prices; range figures are labelled by test standard.`}
>
  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 py-16">
    <div class="text-center mb-10">
      <h1 class="text-4xl sm:text-5xl font-bold mb-4 text-gray-900">Chinese New-Energy Vehicle Database</h1>
      <p class="text-lg text-gray-600 max-w-2xl mx-auto">
        {vehicleCount} vehicles · {brandCount} brands
      </p>
    </div>

    <!-- 数据集范围说明（口径/价格含义/续航标准） -->
    <div class="max-w-4xl mx-auto mb-10 rounded-xl border border-gray-200 bg-gray-50 px-6 py-5 text-sm text-gray-600">
      <h2 class="font-semibold text-gray-900 mb-2 text-base">About this dataset</h2>
      <ul class="space-y-1.5">
        <li><span class="font-medium text-gray-700">Scope:</span> {vehicleCount} Chinese new-energy vehicle records across {brandCount} brands, including BEV, PHEV, EREV, HEV, and a small number of ICE reference vehicles.</li>
        <li><span class="font-medium text-gray-700">Prices:</span> shown in USD as China ex-factory reference prices (starting price), not retail, FOB, or landed cost. Confirm actual quotes with a supplier.</li>
        <li><span class="font-medium text-gray-700">Range:</span> labelled by test standard — CLTC unless otherwise marked (WLTP/EPA/NEDC shown separately where available). CLTC figures run higher than WLTP.</li>
        <li><span class="font-medium text-gray-700">Completeness:</span> records are tiered by data completeness (A / B / C); incomplete fields are shown as N/A rather than estimated.</li>
      </ul>
    </div>

    <!-- 筛选器（客户端，无索引 URL） -->
    <div id="directory-root" class="space-y-5">
      <div class="space-y-3">
        <div class="flex flex-wrap items-center gap-2 justify-center">
          <span class="text-sm font-semibold text-gray-500 uppercase tracking-wide mr-1">Powertrain</span>
          <button data-filter="powertrain" data-value="all" class="chip active">All</button>
          {powertrains.map((p) => (
            <button data-filter="powertrain" data-value={p} class="chip" title={powertrainLabel(p)}>{p}</button>
          ))}
        </div>
        <div class="flex flex-wrap items-center gap-2 justify-center">
          <span class="text-sm font-semibold text-gray-500 uppercase tracking-wide mr-1">Body type</span>
          <button data-filter="type" data-value="all" class="chip active">All</button>
          {bodyTypes.map((t) => (
            <button data-filter="type" data-value={t} class="chip">{t}</button>
          ))}
        </div>
        <div class="flex flex-wrap items-center gap-2 justify-center">
          <span class="text-sm font-semibold text-gray-500 uppercase tracking-wide mr-1">Price</span>
          <button data-filter="price" data-value="all" class="chip active">All</button>
          <button data-filter="price" data-value="0-10000" class="chip">Under $10k</button>
          <button data-filter="price" data-value="10000-20000" class="chip">$10k–20k</button>
          <button data-filter="price" data-value="20000-30000" class="chip">$20k–30k</button>
          <button data-filter="price" data-value="30000-999999" class="chip">$30k+</button>
        </div>
        <div class="flex flex-wrap items-center gap-2 justify-center">
          <span class="text-sm font-semibold text-gray-500 uppercase tracking-wide mr-1">Brand</span>
          <select id="brand-select" class="bg-white border border-gray-300 rounded-lg px-3 py-2 text-sm text-gray-800 focus:border-green-500 focus:ring-2 focus:ring-green-200 outline-none">
            <option value="all">All brands</option>
            {[...new Set(items.map((i) => i.brandLabel))].sort().map((b) => (
              <option value={b}>{b}</option>
            ))}
          </select>
        </div>
        <p class="text-xs text-gray-400 text-center pt-1">
          Powertrain key: BEV = battery electric · PHEV = plug-in hybrid · EREV = extended-range electric ·
          HEV = non-plug-in hybrid · ICE = internal combustion. Filtering runs in your browser — it does not
          create new pages or URLs.
        </p>
      </div>

      <div class="text-sm text-gray-500 text-center">
        Showing <span id="result-count" class="font-semibold text-gray-800">{vehicleCount}</span> of {vehicleCount} vehicles
      </div>

      <div id="directory-results" class="grid md:grid-cols-2 lg:grid-cols-3 gap-6"></div>
    </div>
  </div>
</MarketingLayout>

<style>
  .chip {
    padding: 0.375rem 0.875rem;
    border-radius: 9999px;
    border: 1px solid #e5e7eb;
    color: #4b5563;
    font-size: 0.8125rem;
    font-weight: 500;
    transition: all 0.15s ease;
    cursor: pointer;
  }
  .chip:hover {
    border-color: #16a34a;
    color: #16a34a;
  }
  .chip.active {
    background: #16a34a;
    border-color: #16a34a;
    color: #fff;
  }
</style>

<script>
  const ROOT = document.getElementById('directory-root');
  const ITEMS = JSON.parse(document.getElementById('directory-data').textContent);
  const RESULTS = document.getElementById('directory-results');
  const BRAND_SELECT = document.getElementById('brand-select');
  const RESULT_COUNT = document.getElementById('result-count');

  const state = { powertrain: 'all', type: 'all', price: 'all', brand: 'all' };

  function esc(s) {
    return String(s).replace(/&/g, '&amp;').replace(/</g, '&lt;').replace(/>/g, '&gt;').replace(/"/g, '&quot;');
  }

  function priceInBand(p, band) {
    if (band === 'all') return true;
    const [lo, hi] = band.split('-').map(Number);
    return p >= lo && p < hi;
  }

  function render() {
    const matches = ITEMS.filter((it) =>
      (state.powertrain === 'all' || it.powertrain === state.powertrain) &&
      (state.type === 'all' || it.type === state.type) &&
      priceInBand(it.price, state.price) &&
      (state.brand === 'all' || it.brandLabel === state.brand)
    );

    RESULT_COUNT.textContent = matches.length;

    if (!matches.length) {
      RESULTS.innerHTML = '<div class="col-span-full text-center text-gray-500 py-10">No vehicles match these filters.</div>';
      return;
    }
    RESULTS.innerHTML = matches.map((it) => `
      <a href="/vehicles/${esc(it.slug)}/" class="block border border-gray-200 rounded-xl overflow-hidden hover:shadow-lg transition group bg-white">
        ${it.image ? `<div class="aspect-[4/3] bg-gray-100 overflow-hidden"><img src="${esc(it.image)}" alt="${esc(it.title)} — ${esc(it.type)} (${esc(it.powertrain)})" loading="lazy" width="400" height="300" class="w-full h-full object-cover group-hover:scale-105 transition-transform" /></div>` : ''}
        <div class="p-6">
          <div class="flex items-center gap-2 mb-3">
            <span class="px-2 py-0.5 bg-green-600/10 text-green-600 rounded text-xs font-medium">${esc(it.type)}</span>
            <span class="px-2 py-0.5 bg-gray-600/10 text-gray-600 rounded text-xs font-medium" title="${esc(it.powertrain)}">${esc(it.powertrain)}</span>
          </div>
          <h2 class="text-xl font-bold mb-1 text-gray-900">${esc(it.title)}</h2>
          <p class="text-green-600 font-semibold mb-1">$${it.price.toLocaleString()} <span class="text-xs font-normal text-gray-500">ex-factory</span></p>
          ${it.range ? `<p class="text-xs text-gray-500 mb-1">${it.range} km CLTC</p>` : ''}
          <p class="text-sm text-gray-500 line-clamp-2">${esc(it.description)}</p>
        </div>
      </a>
    `).join('');
  }

  ROOT.querySelectorAll('button.chip').forEach((btn) => {
    btn.addEventListener('click', () => {
      const filter = btn.dataset.filter;
      const value = btn.dataset.value;
      state[filter] = value;
      ROOT.querySelectorAll(`button.chip[data-filter="${filter}"]`).forEach((b) => b.classList.remove('active'));
      btn.classList.add('active');
      render();
    });
  });

  BRAND_SELECT.addEventListener('change', () => {
    state.brand = BRAND_SELECT.value;
    render();
  });

  render();
</script>

<script type="application/json" id="directory-data" set:html={itemsJson} />
