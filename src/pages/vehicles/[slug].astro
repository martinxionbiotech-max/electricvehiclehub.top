---
import { getCollection } from 'astro:content';
import MarketingLayout from '@/layouts/MarketingLayout.astro';
import { url as siteUrl, company } from '@/config/site';
import { brandLabelMap, vehicleAlt } from '@/lib/brand-label';
import { powertrainLabel } from '@/lib/powertrain';
import paramVerification from '@/data/parameter-verification.json';

export async function getStaticPaths() {
  const vehicles = await getCollection('vehicles');
  return vehicles.map((v) => ({
    params: { slug: v.data.slug },
  }));
}

const { slug } = Astro.params;
const vehicles = await getCollection('vehicles');
const brandMap = await brandLabelMap();
const vehicle = vehicles.find((v) => v.data.slug === slug);
const { data } = vehicle;

/** N/A fallback for string/optional fields (zero fabrication). */
const na = (v: unknown, suffix = ''): string =>
  v == null || v === '' ? 'N/A' : `${v}${suffix}`;

/** Price basis derived from the record's price_type (never estimated). */
const priceBasis = data.price_type || 'China ex-factory reference price';
const isChinaExFactory = /ex-factory/i.test(priceBasis);
// Market is derived from the price basis, not asserted independently.
const priceMarket = isChinaExFactory ? 'China (domestic)' : 'Not stated';

const batterySpec = data.battery_type
  ? `${data.battery_type}${data.battery_kwh ? ` · ${data.battery_kwh} kWh` : ''}`
  : data.battery_kwh
    ? `${data.battery_kwh} kWh`
    : null;

const drivePower = data.total_power_kw ?? data.motor_power_kw;

// ── ⑤ HS code + certification facts only (export intel lives on .net) ──
const hsCode =
  data.hs_code ||
  (data.powertrain === 'BEV'
    ? '87038000'
    : ['PHEV', 'EREV', 'HEV'].includes(data.powertrain)
      ? '870340'
      : 'N/A');
const hsNote =
  data.powertrain === 'BEV'
    ? '87038000 — electrically propelled motor vehicles (BEV)'
    : ['PHEV', 'EREV', 'HEV'].includes(data.powertrain)
      ? '870340 — plug-in hybrid / hybrid electric vehicles'
      : 'Not classified (powertrain outside BEV/PHEV/HEV scope)';

// ── ⑥ trim list (recorded verbatim; no per-trim spec breakdown is fabricated) ──
const trimParts = data.trim
  ? data.trim.split('/').map((s) => s.trim()).filter(Boolean)
  : [];
const hasTrimVariants = trimParts.length > 1;

// ── ⑦ competitor comparison: same body type + same powertrain, closest price ──
const competitors = vehicles
  .filter(
    (v) =>
      v.data.slug !== slug &&
      v.data.type === data.type &&
      v.data.powertrain === data.powertrain,
  )
  .map((v) => ({ ...v, priceDelta: Math.abs(v.data.price_usd - data.price_usd) }))
  .sort((a, b) => a.priceDelta - b.priceDelta)
  .slice(0, 4);
const hasCompetitors = competitors.length >= 2;

// ── ⑩ internal links: same brand + same family ──
const sameBrandVehicles = vehicles
  .filter((v) => v.data.brand === data.brand && v.data.slug !== slug)
  .slice(0, 4);
const sameFamilyVehicles = vehicles.filter(
  (v) =>
    v.data.slug !== slug &&
    v.data.brand === data.brand &&
    v.data.family &&
    v.data.family === data.family,
);

// ── grouped specification groups (render only present values) ──
type SpecRow = { label: string; value: string };
const specs = {
  dimensions: [
    { label: 'Length', value: data.length_mm ? `${data.length_mm} mm` : null },
    { label: 'Width', value: data.width_mm ? `${data.width_mm} mm` : null },
    { label: 'Height', value: data.height_mm ? `${data.height_mm} mm` : null },
    { label: 'Wheelbase', value: data.wheelbase_mm ? `${data.wheelbase_mm} mm` : null },
    { label: 'Curb weight', value: data.weight_kg ? `${data.weight_kg} kg` : null },
    { label: 'Gross weight', value: data.gross_weight_kg ? `${data.gross_weight_kg} kg` : null },
    { label: 'Ground clearance', value: data.ground_clearance_mm ? `${data.ground_clearance_mm} mm` : null },
    { label: 'Trunk capacity', value: data.trunk_l ? `${data.trunk_l} L` : null },
    { label: 'Drag coefficient (Cd)', value: data.drag_coefficient != null ? String(data.drag_coefficient) : null },
  ].filter((s) => s.value) as SpecRow[],
  performance: [
    { label: 'Drive layout', value: data.drive_type || null },
    { label: 'Motor type', value: data.motor_type || null },
    { label: 'Motor power', value: data.motor_power_kw ? `${data.motor_power_kw} kW` : null },
    { label: 'Total power (combined)', value: data.total_power_kw ? `${data.total_power_kw} kW` : null },
    { label: 'Torque', value: data.torque_nm ? `${data.torque_nm} Nm` : null },
    { label: '0–100 km/h', value: data.accel_0_100_s ? `${data.accel_0_100_s} s` : null },
    { label: 'Top speed', value: data.top_speed_kmh ? `${data.top_speed_kmh} km/h` : null },
    { label: 'Efficiency', value: data.efficiency_kwh_100km ? `${data.efficiency_kwh_100km} kWh/100km` : null },
    { label: 'Front suspension', value: data.suspension_front || null },
    { label: 'Rear suspension', value: data.suspension_rear || null },
    { label: 'Brakes', value: data.brakes || null },
  ].filter((s) => s.value) as SpecRow[],
  battery: [
    { label: 'Capacity', value: data.battery_kwh ? `${data.battery_kwh} kWh` : null },
    { label: 'Chemistry / type', value: data.battery_type || null },
    { label: 'Thermal management', value: data.battery_thermal || null },
    { label: 'Heat pump', value: data.heat_pump || null },
  ].filter((s) => s.value) as SpecRow[],
  charging: [
    { label: 'Fast charge', value: data.fast_charge || null },
    { label: 'Charging interface', value: data.charging_interface || null },
    { label: 'Charging adapter (export)', value: data.charging_adapter || null },
  ].filter((s) => s.value) as SpecRow[],
};

// ── ④ range standards, each labelled + trim applicability ──
const rangeStandards = [
  { label: 'CLTC', value: data.range_cltc_km ? `${data.range_cltc_km} km` : null },
  { label: 'CLTC (long-range)', value: data.range_long_km ? `${data.range_long_km} km` : null },
  { label: 'WLTP', value: data.range_wltp_km ? `${data.range_wltp_km} km` : null },
  { label: 'EPA', value: data.range_epa_km ? `${data.range_epa_km} km` : null },
  { label: 'NEDC', value: data.range_nedc_km ? `${data.range_nedc_km} km` : null },
].filter((s) => s.value);

// ── ⑨ unresolved (key fields absent from the record) ──
const keyFields: [string, unknown][] = [
  ['range (CLTC)', data.range_cltc_km],
  ['battery capacity', data.battery_kwh],
  ['motor power', data.motor_power_kw],
  ['torque', data.torque_nm],
  ['0–100 km/h', data.accel_0_100_s],
  ['top speed', data.top_speed_kmh],
  ['curb weight', data.weight_kg],
  ['model year', data.model_year],
  ['trim', data.trim],
  ['range (WLTP)', data.range_wltp_km],
];
const unresolved = keyFields.filter(([, v]) => v == null).map(([k]) => k);

const tier = data.quality_tier || 'B';
const isCompact = tier === 'C';

// ── parameter-level verification (batch 01 — featured 6 + A-tier Tier-1 top 30) ──
const paramV = (paramVerification as any).vehicles?.[slug];
const paramOrder = ['price', 'range', 'battery', 'motor', 'accel', 'charge'] as const;
const paramLabels: Record<string, string> = {
  price: 'Price',
  range: 'Range (CLTC)',
  battery: 'Battery',
  motor: 'Motor power',
  accel: '0–100 km/h',
  charge: 'Fast charge',
};
const statusTone: Record<string, string> = {
  verified: 'text-green-700 bg-green-50 border-green-200',
  mismatch: 'text-red-700 bg-red-50 border-red-200',
  unverifiable: 'text-gray-600 bg-gray-50 border-gray-200',
  conflict: 'text-amber-800 bg-amber-50 border-amber-300',
};
const statusLabel: Record<string, string> = {
  verified: 'verified',
  mismatch: 'mismatch',
  unverifiable: 'unverified',
  conflict: 'conflict',
};
const paramRows = paramV
  ? paramOrder
      .filter((p) => paramV[p])
      .map((p) => ({ key: p, label: paramLabels[p], cell: paramV[p] }))
  : [];
const hasParamV = paramRows.length > 0;
const conflictRows = paramRows.filter((r) => r.cell.status === 'conflict');

// structured-data / share image
const pageUrl = new URL(Astro.url.pathname, siteUrl).href;
const vehicleImage = new URL(data.image || '/og-image.png', siteUrl).href;

const fuelTypeByPowertrain = {
  BEV: 'Electric',
  PHEV: 'Plug-in hybrid',
  EREV: 'Extended-range electric',
  HEV: 'Hybrid',
  ICE: 'Gasoline',
  Unknown: undefined,
};
const jsonLd = {
  '@context': 'https://schema.org',
  '@type': 'Vehicle',
  '@id': `${pageUrl}#vehicle`,
  url: pageUrl,
  image: [vehicleImage],
  name: data.title,
  description: data.description,
  brand: { '@type': 'Brand', name: (brandMap.get(data.brand) || data.brand).toUpperCase() },
  bodyType: data.type,
  fuelType: fuelTypeByPowertrain[data.powertrain],
  ...(data.motor_power_kw
    ? {
        vehicleEngine: {
          '@type': 'EngineSpecification',
          enginePower: { '@type': 'QuantitativeValue', value: data.motor_power_kw, unitCode: 'KWT' },
        },
      }
    : {}),
  ...(data.price_usd
    ? {
        offers: {
          '@type': 'Offer',
          url: pageUrl,
          price: data.price_usd,
          priceCurrency: data.currency || 'USD',
          description: `${priceBasis} — reference starting price. Confirm with a supplier quote.`,
        },
      }
    : {}),
};

---

<MarketingLayout
  title={data.title}
  description={data.description}
  image={vehicleImage}
  breadcrumb={[
    { name: 'Home', item: siteUrl },
    { name: 'Vehicles', item: `${siteUrl}/vehicles/` },
    { name: (brandMap.get(data.brand) || data.brand).toUpperCase(), item: `${siteUrl}/brands/${data.brand}/` },
    { name: data.title },
  ]}
  type="website"
  author={data.author}
>
  <article class="max-w-5xl mx-auto px-4 sm:px-6 lg:px-8 py-12">
    <nav class="text-sm text-gray-500 mb-6" aria-label="Breadcrumb">
      <a href="/" class="hover:text-green-600">Home</a> / <a href="/vehicles/" class="hover:text-green-600">Vehicles</a> / <a href={`/brands/${data.brand}/`} class="hover:text-green-600">{(brandMap.get(data.brand) || data.brand).toUpperCase()}</a> / <span class="text-gray-700">{data.title}</span>
    </nav>

    <!-- ① identity -->
    <div class="mb-8">
      <div class="flex flex-wrap items-center gap-2 mb-4">
        <span class="inline-block px-3 py-1 bg-green-600/10 text-green-700 rounded-full text-xs font-semibold">{data.type}</span>
        <span class="inline-block px-3 py-1 bg-green-600/10 text-green-600 rounded-full text-xs font-semibold" title={powertrainLabel(data.powertrain)}>{data.powertrain}</span>
        <a href={`/brands/${data.brand}/`} class="inline-block px-3 py-1 bg-gray-600/10 text-gray-600 rounded-full text-xs font-semibold hover:bg-green-600/10 hover:text-green-700">{(brandMap.get(data.brand) || data.brand).toUpperCase()} brand</a>
      </div>
      <h1 class="text-3xl md:text-4xl font-bold mb-3 text-gray-900">{data.title}</h1>
      <p class="text-xl text-green-700 font-bold">
        ${data.price_usd.toLocaleString()}{' '}
        <span class="text-sm font-normal text-gray-500">({priceBasis})</span>
      </p>
      <p class="text-sm text-gray-500 mt-2">
        {data.powertrain} · {powertrainLabel(data.powertrain)} · {data.type}
        {data.trim ? <> · Trims: {data.trim}</> : ''}
        {data.family ? <> · Family: {data.family}</> : ''}
      </p>
    </div>

    {isCompact && (
      <div class="mb-8 rounded-xl border border-amber-300 bg-amber-50 px-5 py-4">
        <p class="text-sm font-semibold text-amber-800">Data status: partial — compact record</p>
        <p class="text-xs text-amber-700 mt-1 leading-relaxed">
          Key specifications (range, battery, power, or performance) are not fully confirmed for this model.
          Figures shown are indicative and should be verified against the manufacturer or a supplier quote before ordering.
        </p>
      </div>
    )}

    {data.image && (
      <div class="mb-8 overflow-hidden rounded-2xl border border-gray-200 shadow-sm">
        <img
          src={data.image}
          alt={vehicleAlt(data, brandMap)}
          class="w-full h-auto object-cover"
          loading="eager"
          width="1200"
          height="675"
        />
        {data.image_credit && (
          <p class="px-4 py-2 text-xs text-gray-500 bg-gray-50 border-t border-gray-200">
            {/China EV Mart original/i.test(data.image_credit) ? 'Illustration' : 'Photo'}: {data.image_credit}
            {data.image_source && (<> · <a href={data.image_source} rel="nofollow noopener" target="_blank" class="underline hover:text-green-700">source</a></>)}
          </p>
        )}
      </div>
    )}

    {/* ② concise factual summary (zero fabrication) */}
    <section class="mb-10">
      <h2 class="text-2xl font-bold mb-3 text-gray-900">Summary</h2>
      <p class="text-gray-700 leading-relaxed">
        The <strong>{data.title}</strong> is a {data.type.toLowerCase()} {powertrainLabel(data.powertrain).toLowerCase()} from{' '}
        {(brandMap.get(data.brand) || data.brand).toUpperCase()}, listed at ${data.price_usd.toLocaleString()} {priceBasis.toLowerCase()}.
        {data.range_cltc_km ? <> Its CLTC-rated range is {data.range_cltc_km} km</> : <> CLTC range is not recorded</>}
        {data.battery_kwh ? <> from a {data.battery_kwh} kWh pack</> : ''}
        {drivePower ? <> with {drivePower} kW of drive power</> : ''}. This page records the published specifications;
        figures not confirmed by the manufacturer are shown as N/A rather than estimated.
      </p>
    </section>

    {/* ③ grouped specifications */}
    <section class="mb-10">
      <h2 class="text-2xl font-bold mb-4 text-gray-900">Specifications</h2>
      <div class="space-y-6">
        {specs.dimensions.length > 0 && (
          <div>
            <h3 class="text-lg font-semibold text-gray-800 mb-2">Dimensions &amp; weight</h3>
            <div class="rounded-xl border border-gray-200 overflow-hidden">
              <table class="w-full text-sm"><tbody>{specs.dimensions.map((s, i) => (
                <tr class={i % 2 === 0 ? 'bg-gray-50' : 'bg-white'}><td class="px-5 py-3 font-medium text-gray-700 w-2/5">{s.label}</td><td class="px-5 py-3 text-gray-900">{s.value}</td></tr>
              ))}</tbody></table>
            </div>
          </div>
        )}
        {specs.performance.length > 0 && (
          <div>
            <h3 class="text-lg font-semibold text-gray-800 mb-2">Performance</h3>
            <div class="rounded-xl border border-gray-200 overflow-hidden">
              <table class="w-full text-sm"><tbody>{specs.performance.map((s, i) => (
                <tr class={i % 2 === 0 ? 'bg-gray-50' : 'bg-white'}><td class="px-5 py-3 font-medium text-gray-700 w-2/5">{s.label}</td><td class="px-5 py-3 text-gray-900">{s.value}</td></tr>
              ))}</tbody></table>
            </div>
          </div>
        )}
        {specs.battery.length > 0 && (
          <div>
            <h3 class="text-lg font-semibold text-gray-800 mb-2">Battery</h3>
            <div class="rounded-xl border border-gray-200 overflow-hidden">
              <table class="w-full text-sm"><tbody>{specs.battery.map((s, i) => (
                <tr class={i % 2 === 0 ? 'bg-gray-50' : 'bg-white'}><td class="px-5 py-3 font-medium text-gray-700 w-2/5">{s.label}</td><td class="px-5 py-3 text-gray-900">{s.value}</td></tr>
              ))}</tbody></table>
            </div>
          </div>
        )}
        {specs.charging.length > 0 && (
          <div>
            <h3 class="text-lg font-semibold text-gray-800 mb-2">Charging</h3>
            <div class="rounded-xl border border-gray-200 overflow-hidden">
              <table class="w-full text-sm"><tbody>{specs.charging.map((s, i) => (
                <tr class={i % 2 === 0 ? 'bg-gray-50' : 'bg-white'}><td class="px-5 py-3 font-medium text-gray-700 w-2/5">{s.label}</td><td class="px-5 py-3 text-gray-900">{s.value}</td></tr>
              ))}</tbody></table>
            </div>
          </div>
        )}
      </div>
    </section>

    {/* ④ range standards + trim applicability */}
    <section class="mb-10">
      <h2 class="text-2xl font-bold mb-4 text-gray-900">Range by test standard</h2>
      {rangeStandards.length > 0 ? (
        <div class="rounded-xl border border-gray-200 overflow-hidden">
          <table class="w-full text-sm">
            <thead>
              <tr class="bg-gray-50 text-left">
                <th class="px-5 py-3 font-semibold text-gray-700 w-2/5">Test standard</th>
                <th class="px-5 py-3 font-semibold text-gray-700">Range</th>
              </tr>
            </thead>
            <tbody>
              {rangeStandards.map((r, i) => (
                <tr class={i % 2 === 0 ? 'bg-white' : 'bg-gray-50'}>
                  <td class="px-5 py-3 text-gray-700">{r.label}</td>
                  <td class="px-5 py-3 text-gray-900">{r.value}</td>
                </tr>
              ))}
            </tbody>
          </table>
        </div>
      ) : (
        <p class="text-gray-500">No range figure is recorded for this model.</p>
      )}
      <p class="text-xs text-gray-400 mt-3 leading-relaxed">
        Range is labelled by test standard and is never combined across standards. CLTC figures run higher than WLTP/EPA
        for the same vehicle. {hasTrimVariants
          ? 'Range may differ by trim; the dataset records one figure per standard (base/representative configuration).'
          : 'Where a single figure is shown, it applies to the base/representative configuration.'}
      </p>
    </section>

    {/* ⑤ price block */}
    <section class="mb-10">
      <h2 class="text-2xl font-bold mb-4 text-gray-900">Price</h2>
      <div class="rounded-xl border border-gray-200 overflow-hidden">
        <table class="w-full text-sm">
          <tbody>
            <tr class="bg-gray-50"><td class="px-5 py-3 font-medium text-gray-700 w-2/5">Price type</td><td class="px-5 py-3 text-gray-900">{priceBasis}</td></tr>
            <tr class="bg-white"><td class="px-5 py-3 font-medium text-gray-700">Amount</td><td class="px-5 py-3 text-gray-900">${data.price_usd.toLocaleString()}</td></tr>
            <tr class="bg-gray-50"><td class="px-5 py-3 font-medium text-gray-700">Currency</td><td class="px-5 py-3 text-gray-900">{data.currency || 'USD'}</td></tr>
            <tr class="bg-white"><td class="px-5 py-3 font-medium text-gray-700">Market</td><td class="px-5 py-3 text-gray-900">{priceMarket}</td></tr>
            <tr class="bg-gray-50"><td class="px-5 py-3 font-medium text-gray-700">Data as of</td><td class="px-5 py-3 text-gray-900">{data.data_updated || 'Not recorded'}</td></tr>
            <tr class="bg-white"><td class="px-5 py-3 font-medium text-gray-700">Source</td><td class="px-5 py-3 text-gray-900">{data.data_source || 'China EV Mart catalog'}</td></tr>
          </tbody>
        </table>
      </div>
      <p class="text-xs text-gray-400 mt-3">
        Prices are {priceBasis.toLowerCase()}, not retail, FOB, or landed cost. The figure is a reference starting price —
        confirm an actual quote with a supplier.
      </p>
    </section>

    {/* ⑥ trim differences (only when trim data exists) */}
    {hasTrimVariants && (
      <section class="mb-10">
        <h2 class="text-2xl font-bold mb-4 text-gray-900">Versions / trims</h2>
        <ul class="space-y-2">
          {trimParts.map((t) => (
            <li class="px-4 py-2.5 bg-white border border-gray-200 rounded-lg text-sm text-gray-800">{t}</li>
          ))}
        </ul>
        <p class="text-xs text-gray-400 mt-3">
          Version names are recorded verbatim from the vehicle record. A per-trim specification breakdown is not
          available in the dataset, so differences between versions are not stated here.
        </p>
      </section>
    )}

    {/* ⑦ competitor comparison (compatible: same body type + powertrain) */}
    {!isCompact && hasCompetitors && (
      <section class="mb-10">
        <h2 class="text-2xl font-bold mb-4 text-gray-900">Comparable {data.type} {data.powertrain}s</h2>
        <p class="text-sm text-gray-500 mb-4">
          Same body type ({data.type}) and powertrain ({data.powertrain}), closest in ex-factory reference price.
        </p>
        <div class="rounded-xl border border-gray-200 overflow-hidden">
          <table class="w-full text-sm">
            <thead>
              <tr class="bg-gray-50 text-left">
                <th class="px-4 py-3 font-semibold text-gray-700">Model</th>
                <th class="px-4 py-3 font-semibold text-gray-700">Price (ex-factory)</th>
                <th class="px-4 py-3 font-semibold text-gray-700">Range (CLTC)</th>
                <th class="px-4 py-3 font-semibold text-gray-700">Battery</th>
              </tr>
            </thead>
            <tbody>
              {competitors.map((c, i) => (
                <tr class={i % 2 === 0 ? 'bg-white' : 'bg-gray-50'}>
                  <td class="px-4 py-3 text-gray-900">
                    <a href={`/vehicles/${c.data.slug}/`} class="text-green-700 hover:underline font-medium">{c.data.title}</a>
                  </td>
                  <td class="px-4 py-3 text-gray-900">${c.data.price_usd.toLocaleString()}</td>
                  <td class="px-4 py-3 text-gray-900">{c.data.range_cltc_km ? `${c.data.range_cltc_km} km` : 'N/A'}</td>
                  <td class="px-4 py-3 text-gray-900">{c.data.battery_kwh ? `${c.data.battery_kwh} kWh` : 'N/A'}</td>
                </tr>
              ))}
            </tbody>
          </table>
        </div>
      </section>
    )}

    {/* ⑧ export considerations (verified only) */}
    <section class="mb-10">
      <h2 class="text-2xl font-bold mb-4 text-gray-900">Export considerations</h2>
      <div class="rounded-xl border border-gray-200 overflow-hidden">
        <table class="w-full text-sm">
          <tbody>
            <tr class="bg-gray-50"><td class="px-5 py-3 font-medium text-gray-700 w-2/5">HS code</td><td class="px-5 py-3 text-gray-900">{hsCode} — {hsNote}</td></tr>
            <tr class="bg-white"><td class="px-5 py-3 font-medium text-gray-700">Certification notes</td><td class="px-5 py-3 text-gray-900">{na(data.certification_notes)}</td></tr>
          </tbody>
        </table>
      </div>
      <div class="mt-4 rounded-xl border border-green-200 bg-green-50 px-5 py-4">
        <p class="text-sm text-green-800 font-medium">Landed-cost &amp; per-market export data</p>
        <p class="text-xs text-green-700 mt-1 leading-relaxed">
          Landed-cost, import-duty, and per-market pricing for this model is published on{' '}
          <a href={`https://electricvehiclehub.net/vehicles/${data.slug}/`} class="font-semibold underline" rel="noopener" target="_blank">electricvehiclehub.net</a>{' '}
          — see the full export profile there.
        </p>
      </div>
    </section>

    {/* ⑨ sources / last-checked / unresolved */}
    <section class="mb-10">
      <h2 class="text-2xl font-bold mb-4 text-gray-900">Data provenance &amp; verification</h2>
      <div class="rounded-xl border border-gray-200 overflow-hidden">
        <table class="w-full text-sm">
          <tbody>
            <tr class="bg-gray-50"><td class="px-5 py-3 font-medium text-gray-700 w-2/5">Source</td><td class="px-5 py-3 text-gray-900">{data.data_source || 'China EV Mart catalog'}</td></tr>
            <tr class="bg-white"><td class="px-5 py-3 font-medium text-gray-700">Last checked</td><td class="px-5 py-3 text-gray-900">{data.data_updated || 'Not recorded'}</td></tr>
            <tr class="bg-gray-50"><td class="px-5 py-3 font-medium text-gray-700">Verification status</td><td class="px-5 py-3 text-gray-900">{data.verification_status || 'Pending review'}</td></tr>
            <tr class="bg-white"><td class="px-5 py-3 font-medium text-gray-700">Completeness tier</td><td class="px-5 py-3 text-gray-900">Tier {tier}{data.data_tier != null ? ` (data tier ${data.data_tier})` : ''}</td></tr>
          </tbody>
        </table>
      </div>
      {unresolved.length > 0 && (
        <p class="text-xs text-amber-700 mt-3">
          Not yet recorded: {unresolved.join(', ')}. These fields are shown as N/A rather than estimated.
        </p>
      )}
      <p class="mt-3 text-xs text-gray-500">
        <a
          href={`mailto:${company.email}?subject=${encodeURIComponent(`Data issue: ${data.slug}`)}&body=${encodeURIComponent(`Reporting a data issue for ${data.title} (slug: ${data.slug}, /vehicles/${data.slug}/).\n\nField(s): \nCurrent value: \nCorrect value / source: `)}`}
          class="text-green-700 hover:underline font-medium"
        >
          Report a data issue for this model →
        </a>
      </p>
    </section>

    {/* ⓐ key-parameter verification (batch 01 — source / verified_at / model_year / trim / confidence / status) */}
    {hasParamV && (
      <section class="mb-10">
        <h2 class="text-2xl font-bold mb-4 text-gray-900">Key parameter verification</h2>
        <p class="text-sm text-gray-500 mb-4">
          Parameter-level source metadata for the six key parameters. A figure marked{' '}
          <span class="font-semibold text-amber-800">conflict</span> is flagged for review — the value is shown as recorded, not silently replaced.
        </p>
        <div class="rounded-xl border border-gray-200 overflow-hidden">
          <table class="w-full text-sm">
            <thead>
              <tr class="bg-gray-50 text-left">
                <th class="px-4 py-3 font-semibold text-gray-700">Parameter</th>
                <th class="px-4 py-3 font-semibold text-gray-700">Value</th>
                <th class="px-4 py-3 font-semibold text-gray-700">Status</th>
                <th class="px-4 py-3 font-semibold text-gray-700">Source</th>
                <th class="px-4 py-3 font-semibold text-gray-700">Verified</th>
              </tr>
            </thead>
            <tbody>
              {paramRows.map((r, i) => (
                <tr class={i % 2 === 0 ? 'bg-white' : 'bg-gray-50'}>
                  <td class="px-4 py-3 text-gray-700 font-medium">{r.label}</td>
                  <td class="px-4 py-3 text-gray-900">{r.cell.value != null ? String(r.cell.value) : 'N/A'}</td>
                  <td class="px-4 py-3">
                    <span class={`inline-block px-2 py-0.5 rounded-full text-xs font-semibold border ${statusTone[r.cell.status] || statusTone.unverifiable}`}>
                      {statusLabel[r.cell.status] || 'unverified'}
                    </span>
                  </td>
                  <td class="px-4 py-3 text-gray-700">{r.cell.source || '—'}</td>
                  <td class="px-4 py-3 text-gray-700">{r.cell.verified_at || '—'}</td>
                </tr>
              ))}
            </tbody>
          </table>
        </div>
        {conflictRows.length > 0 && (
          <div class="mt-4 rounded-xl border border-amber-300 bg-amber-50 px-5 py-4">
            <p class="text-sm font-semibold text-amber-800">Fields flagged for review</p>
            <ul class="mt-2 space-y-1 text-xs text-amber-700 list-disc pl-5">
              {conflictRows.map((r) => (
                <li><strong>{r.label}</strong>{r.cell.note ? `: ${r.cell.note}` : ''}</li>
              ))}
            </ul>
            <p class="text-xs text-amber-700 mt-2">Conflicts are recorded, not resolved by guessing. Report a correction via the link below.</p>
          </div>
        )}
      </section>
    )}

    {/* ⑩ internal links */}
    <section class="mb-10">
      <h2 class="text-2xl font-bold mb-4 text-gray-900">Explore further</h2>
      <div class="grid sm:grid-cols-2 gap-3">
        <a href={`/brands/${data.brand}/`} class="px-4 py-3 bg-white border border-gray-200 rounded-xl hover:border-green-500/60 hover:shadow-sm transition">
          <span class="block text-sm font-semibold text-gray-900">{(brandMap.get(data.brand) || data.brand).toUpperCase()} brand</span>
          <span class="block text-xs text-gray-500 mt-0.5">All {data.brand.toUpperCase()} models and brand data</span>
        </a>
        <a href="/vehicles/" class="px-4 py-3 bg-white border border-gray-200 rounded-xl hover:border-green-500/60 hover:shadow-sm transition">
          <span class="block text-sm font-semibold text-gray-900">Vehicle directory</span>
          <span class="block text-xs text-gray-500 mt-0.5">Browse the full {data.powertrain} / {data.type} database</span>
        </a>
        <a href="/blog/tag/comparison/" class="px-4 py-3 bg-white border border-gray-200 rounded-xl hover:border-green-500/60 hover:shadow-sm transition">
          <span class="block text-sm font-semibold text-gray-900">Comparison articles</span>
          <span class="block text-xs text-gray-500 mt-0.5">Editorial comparisons across models and brands</span>
        </a>
        <a href="/docs/glossary/" class="px-4 py-3 bg-white border border-gray-200 rounded-xl hover:border-green-500/60 hover:shadow-sm transition">
          <span class="block text-sm font-semibold text-gray-900">Technology glossary</span>
          <span class="block text-xs text-gray-500 mt-0.5">Powertrain, battery, and charging terms</span>
        </a>
      </div>
      {sameBrandVehicles.length > 0 && (
        <div class="mt-6">
          <h3 class="text-sm font-semibold text-gray-700 mb-3">Other {(brandMap.get(data.brand) || data.brand).toUpperCase()} models</h3>
          <ul class="space-y-2">
            {sameBrandVehicles.map((v) => (
              <li>
                <a href={`/vehicles/${v.data.slug}/`} class="text-green-700 hover:underline font-medium">{v.data.title}</a>
                <span class="text-gray-500 text-sm"> — {v.data.range_cltc_km ? `${v.data.range_cltc_km} km CLTC` : 'range N/A'}{v.data.price_usd ? ` · $${Number(v.data.price_usd).toLocaleString()}` : ''}</span>
              </li>
            ))}
          </ul>
        </div>
      )}
      {sameFamilyVehicles.length > 0 && (
        <div class="mt-6">
          <h3 class="text-sm font-semibold text-gray-700 mb-3">{data.family} family ({data.brand.toUpperCase()})</h3>
          <ul class="space-y-2">
            {sameFamilyVehicles.map((v) => (
              <li>
                <a href={`/vehicles/${v.data.slug}/`} class="text-green-700 hover:underline font-medium">{v.data.title}</a>
                <span class="text-gray-500 text-sm"> — {v.data.powertrain}</span>
              </li>
            ))}
          </ul>
        </div>
      )}
    </section>
  </article>

  <script type="application/ld+json" set:html={JSON.stringify(jsonLd)} />
</MarketingLayout>
