---
import MarketingLayout from '@/layouts/MarketingLayout.astro';
import PageHeader from '@sections/content/PageHeader.astro';
import StatsSection from '@sections/social-proof/StatsSection.astro';
import ValuesSection from '@sections/team/ValuesSection.astro';
import ContentSection from '@sections/content/ContentSection.astro';
import CTA from '@sections/marketing/CTA.astro';
import { siteConfig } from '@/config';

const values = [
  {
    title: 'Deep, Structured Specifications',
    description:
      'Every vehicle is a normalized product record — battery chemistry, powertrain architecture, dimensions, versions, and technology — not a marketing blurb.',
  },
  {
    title: 'Verified Data',
    description:
      'Every spec is cross-checked against manufacturer datasheets and authoritative sources, and stamped with its update date and verification status.',
  },
  {
    title: 'Product-First',
    description:
      'Built for anyone researching Chinese EVs — buyers, analysts, journalists, and enthusiasts — who needs reliable product data rather than sales copy.',
  },
  {
    title: 'Compliance by Default',
    description:
      'HS code classification and certification facts are folded into every record, so the regulatory context sits alongside the specification.',
  },
];

import { getSiteStats } from '@/lib/site-stats';
const s = await getSiteStats();
const stats = [
  { value: String(s.vehicles), label: 'Vehicles Cataloged' },
  { value: String(s.brands), label: 'Chinese Brands' },
  { value: String(s.bevCount + s.phevCount + s.erevCount + s.otherPowertrainCount), label: 'Powertrains Indexed' },
  { value: '1', label: 'Structured Record Format' },
];
---

<MarketingLayout
  title={`About - ${siteConfig.name}`}
  description="EV Hub is an independent Chinese EV product database — deep, source-verified specifications, versions, and technology data across 72 brands."
>
  <PageHeader title="The complete product database for Chinese EVs" align="left" maxWidth="lg">
    <p class="mt-6 text-lg text-text-muted leading-relaxed">
      EV Hub exists to solve a single, persistent problem: Chinese EV specifications are scattered
      across manufacturer sites, press releases, and forum posts, in inconsistent formats and with
      no source provenance. Most research starts with piecing together spec sheets from five
      different places — and still ends up with gaps.
    </p>
    <p class="mt-4 text-lg text-text-muted leading-relaxed">
      We built EV Hub to make that data structured and verifiable <em>before</em> you rely on it.
      Every vehicle page is a normalized product record — battery chemistry, powertrain, dimensions,
      versions, and technology — with the source and update date attached to each figure.
    </p>
  </PageHeader>

  <StatsSection stats={stats} background="muted" />

  <ValuesSection
    title="What we stand for"
    items={values}
    variant="card"
    columns={2}
    background="default"
  />

  <ContentSection
    title="Independent data, verified sources"
    content={[
      "EV Hub is operated by Chengguang Energy (Jinzhou Chengguang Power Source Co., Ltd.), an automotive battery manufacturer whose quality management system is certified to IATF 16949 founded in 2002, and edited by Wei Wang, with a focus on technical accuracy and product data for Chinese electric vehicles.",
      "Our specification methodology is published in full, so any reader can judge how a figure was sourced. We record battery chemistry and architecture at the vehicle level, apply a consistent normalization scheme, and mark any field we could not verify as N/A rather than guessing.",
      "We do not sell vehicles and are not affiliated with any manufacturer. That independence is what lets us publish specifications without a sales agenda.",
    ]}
    background="default"
  />

  <ContentSection
    title="About the author & review process"
    content={[
      "Wei Wang is EV Hub's EV & Battery Industry Analyst. He spent many years in automotive battery production before turning to product research on electric vehicles — battery chemistry, powertrain architecture, and cross-border compliance.",
      "Every specification on EV Hub is cross-checked against authoritative sources: manufacturer datasheets, type-approval databases, and industry records. Data is stamped with its update date and verification status so readers can judge its freshness.",
    ]}
    background="muted"
  />

  <CTA
    title="Start with the full product record"
    description="Browse the complete catalog and see the structured, source-verified specification for any Chinese EV."
    action={{ label: 'Explore Vehicles', href: '/vehicles' }}
    background="muted"
  />
</MarketingLayout>
