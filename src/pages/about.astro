---
import MarketingLayout from '@/layouts/MarketingLayout.astro';
import PageHeader from '@sections/content/PageHeader.astro';
import StatsSection from '@sections/social-proof/StatsSection.astro';
import ValuesSection from '@sections/team/ValuesSection.astro';
import ContentSection from '@sections/content/ContentSection.astro';
import CTA from '@sections/marketing/CTA.astro';
import { siteConfig } from '@/config';

const values = [
  {
    title: 'Transparent Pricing',
    description:
      'We show the full landed cost — vehicle price, duties, countervailing tariffs, VAT, freight, and compliance — so buyers know exactly what they pay before ordering.',
  },
  {
    title: 'Verified Data',
    description:
      'Every spec, tariff rate, and regulation is cross-checked against authoritative sources (EU Implementing Regulation 2024/2754, manufacturer datasheets, customs guidance).',
  },
  {
    title: 'Importer-First',
    description:
      'Built for international EV importers and fleet buyers, not casual browsers. We focus on what matters for a compliant, cost-effective import.',
  },
  {
    title: 'Compliance by Default',
    description:
      'WVTA, GB/T battery standards, and EU homologation requirements are folded into every landed-cost estimate so no surprise costs appear at the border.',
  },
];

import { getSiteStats } from '@/lib/site-stats';
const s = await getSiteStats();
const stats = [
  { value: String(s.vehicles), label: 'Vehicles Cataloged' },
  { value: String(s.brands), label: 'Chinese Brands' },
  { value: String(s.markets), label: 'Export Markets Modeled' },
  { value: '1', label: 'Transparent Formula' },
];
---

<MarketingLayout
  title={`About - ${siteConfig.name}`}
  description="EV Hub is an independent information platform for importing Chinese electric vehicles, built on transparent landed-cost data and verified export compliance."
>
  <PageHeader title="Making Chinese EV imports transparent" align="left" maxWidth="lg">
    <p class="mt-6 text-lg text-text-muted leading-relaxed">
      EV Hub exists to solve a single, persistent problem: the price you see on a Chinese EV
      listing is almost never the price you'll actually pay at port. Duties, countervailing
      tariffs, VAT, freight, certification, and registration all stack up — and most buyers only
      discover the true cost after committing.
    </p>
    <p class="mt-4 text-lg text-text-muted leading-relaxed">
      We built EV Hub to make that number transparent <em>before</em> you buy. Every vehicle page
      includes a full landed-cost breakdown, and every tariff rate is pinned to the latest
      official EU implementing regulation.
    </p>
  </PageHeader>

  <StatsSection stats={stats} background="muted" />

  <ValuesSection
    title="What we stand for"
    items={values}
    variant="card"
    columns={2}
    background="default"
  />

  <ContentSection
    title="Independent data, verified sources"
    content={[
      "EV Hub is operated by Chengguang Energy (Jinzhou Chengguang Power Source Co., Ltd.), an automotive battery manufacturer whose quality management system is certified to IATF 16949 founded in 2002, and edited by Wei Wang, with a focus on technical accuracy and regulatory compliance for cross-border EV trade.",
      "Our landed-cost methodology is published in full, so any importer can reproduce the math. We track EU countervailing duties by brand — BYD, Geely, SAIC, and others all carry different rates — and apply them precisely rather than using a single blanket percentage.",
      "We do not sell vehicles and are not affiliated with any manufacturer. That independence is what lets us report prices and tariffs without a sales agenda.",
    ]}
    background="default"
  />

  <ContentSection
    title="About the author & review process"
    content={[
      "Wei Wang is EV Hub's EV & Battery Industry Analyst. He spent many years in automotive battery production before turning to commercial research on electric vehicles — import economics, tariffs, and cross-border compliance.",
      "Every landed-cost figure on EV Hub follows a single documented formula and is cross-checked against authoritative sources: the EU Implementing Regulation 2024/2754 for countervailing duties, national VAT/GST rates, manufacturer datasheets, and customs guidance. Data is stamped with its update date and review status so readers can judge its freshness.",
    ]}
    background="muted"
  />

  <CTA
    title="Start with the real cost"
    description="Browse the full catalog and see the transparent landed cost for any Chinese EV you're considering."
    action={{ label: 'Explore Vehicles', href: '/vehicles' }}
    background="muted"
  />
</MarketingLayout>

