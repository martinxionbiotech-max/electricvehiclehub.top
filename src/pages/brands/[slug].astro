---
import { getCollection, render } from 'astro:content';
import MarketingLayout from '@/layouts/MarketingLayout.astro';
import { url as siteUrl } from '@/config/site';
import { brandLabelMap, vehicleThumbAlt } from '@/lib/brand-label';

export async function getStaticPaths() {
  const brands = await getCollection('brands');
  return brands.map((b) => ({
    params: { slug: b.id.replace(/\.mdx?$/, '') },
  }));
}

const { slug } = Astro.params;
const brands = await getCollection('brands');
const brandEntry = brands.find((b) => b.id.replace(/\.mdx?$/, '') === slug);
const { data } = brandEntry;
const { Content } = await render(brandEntry);

// 该品牌下的所有车型（brand 字段 = 品牌 slug）
const allVehicles = await getCollection('vehicles');
const brandMap = await brandLabelMap();
const brandVehicles = allVehicles
  .filter((v) => v.data.brand === slug)
  .sort((a, b) => a.data.price_usd - b.data.price_usd);

// Brand JSON-LD schema
const jsonLd = {
  '@context': 'https://schema.org',
  '@type': 'Organization',
  name: data.brand_name,
  description: data.description,
  url: siteUrl + '/brands/' + slug + '/',
  foundingDate: data.established,
  parentOrganization: data.parent_manufacturer
    ? { '@type': 'Organization', name: data.parent_manufacturer, location: data.parent_location }
    : undefined,
};

const breadcrumbLd = {
  '@context': 'https://schema.org',
  '@type': 'BreadcrumbList',
  itemListElement: [
    { '@type': 'ListItem', position: 1, name: 'Home', item: siteUrl },
    { '@type': 'ListItem', position: 2, name: 'Brands', item: `${siteUrl}/brands/` },
    { '@type': 'ListItem', position: 3, name: data.brand_name },
  ],
};
---

<MarketingLayout title={data.brand_name} description={data.description}>
  <article class="max-w-4xl mx-auto px-4 sm:px-6 lg:px-8 py-12">
    <nav class="text-sm text-gray-500 mb-6" aria-label="Breadcrumb">
      <a href="/" class="hover:text-green-600">Home</a> / <a href="/brands/" class="hover:text-green-600">Brands</a> / <span class="text-gray-700">{data.brand_name}</span>
    </nav>

    <div class="flex items-center gap-5 mb-8">
      <div class="w-20 h-20 shrink-0 rounded-2xl bg-green-600 flex items-center justify-center text-white text-4xl font-bold">
        {data.brand_name.charAt(0)}
      </div>
      <div>
        <h1 class="text-4xl font-bold mb-1 text-gray-900">{data.brand_name}</h1>
        <p class="text-lg text-gray-600">Parent: {data.parent_manufacturer} · {data.parent_location} (founded {data.parent_founded})</p>
      </div>
    </div>

    <div class="mb-6 flex flex-wrap items-center gap-2">
      <span class="inline-block px-3 py-1 bg-green-600/10 text-green-600 rounded-full text-xs font-medium">{brandVehicles.length} models</span>
      <span class="inline-block px-3 py-1 bg-gray-600/10 text-gray-600 rounded-full text-xs font-medium">Est. {data.established}</span>
      {data.website && <a href={data.website} class="text-sm text-green-600 hover:underline" rel="noopener">Official website ↗</a>}
    </div>

    <div class="prose prose-lg max-w-none mb-10">
      <Content />
    </div>

    {brandVehicles.length > 0 && (
      <section class="mb-10">
        <h2 class="text-2xl font-bold mb-6 text-gray-900">{data.brand_name} Models ({brandVehicles.length})</h2>
        <div class="grid grid-cols-1 sm:grid-cols-2 gap-4">
          {brandVehicles.map((v) => {
            const lc = v.data.landed_cost;
            const landed = lc?.total_landed_usd ?? 0;
            const premium = lc?.premium_pct ?? 0;
            return (
              <a href={`/vehicles/${v.data.slug}/`} class="flex items-center gap-4 p-4 border border-gray-200 rounded-xl bg-white hover:border-green-500/60 hover:shadow-md transition group">
                {v.data.image && (
                  <div class="w-24 h-18 shrink-0 rounded-lg overflow-hidden bg-gray-100 aspect-[4/3]">
                    <img src={v.data.image} alt={vehicleThumbAlt(v.data, brandMap)} loading="lazy" width="96" height="72" class="w-full h-full object-cover group-hover:scale-105 transition-transform" />
                  </div>
                )}
                <div class="min-w-0 flex-1">
                  <h3 class="font-semibold text-gray-900 group-hover:text-green-600 transition">{v.data.title}</h3>
                  <div class="text-xs text-gray-500 mt-0.5">{v.data.type}
                    {v.data.range_cltc_km && <> · {v.data.range_cltc_km} km</>}
                    {v.data.battery_kwh && <> · {v.data.battery_kwh} kWh</>}
                  </div>
                  <div class="mt-1 text-sm">
                    <span class="font-bold text-gray-900">${v.data.price_usd.toLocaleString()}</span>
                    {landed > 0 && (
                      <span class="text-gray-500 text-xs ml-2">Landed DE <span class="text-green-600 font-semibold">${landed.toLocaleString()}</span> (+{premium}%)</span>
                    )}
                  </div>
                </div>
                <svg class="w-5 h-5 text-gray-300 group-hover:text-green-600 shrink-0" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2"><path stroke-linecap="round" stroke-linejoin="round" d="M9 5l7 7-7 7" /></svg>
              </a>
            );
          })}
        </div>
      </section>
    )}

    <div class="border-t pt-6 text-sm text-gray-500">
      Author: Wei Wang (EV & Battery Industry Analyst) · Chengguang Energy · Updated {data.publishedDate.toISOString().split('T')[0]} · <a href="/contact/" class="text-green-700 hover:underline">Contact</a>
    </div>
  </article>
</MarketingLayout>

<script type="application/ld+json" set:html={JSON.stringify(jsonLd)} />
<script type="application/ld+json" set:html={JSON.stringify(breadcrumbLd)} />
