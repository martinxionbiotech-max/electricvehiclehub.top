---
import MarketingLayout from '@/layouts/MarketingLayout.astro';
import { siteConfig, company } from '@/config';

const lastUpdated = siteConfig.legal.lastUpdated;

const tiers = [
  {
    tier: 'Tier 1 — Official and regulatory',
    examples:
      'EU implementing regulations and TARIC entries, national tax authorities, customs guidance, type-approval databases, official manufacturer datasheets and price lists.',
    use: 'The standard for any figure we state as fact — duty rates, VAT, homologation requirements, published specifications.',
  },
  {
    tier: 'Tier 2 — Authoritative media and analysts',
    examples:
      'Established trade press, recognised industry analysts, and reputable news organisations with editorial standards of their own.',
    use: 'Used when no primary document is public, and preferred for market context and reported developments. Attributed to the outlet, not stated as our own finding.',
  },
  {
    tier: 'Tier 3 — Industry and trade sources',
    examples:
      'Freight and logistics benchmarks, homologation service providers, industry association publications, company statements and investor materials.',
    use: 'Used for cost assumptions and operational realities where these are the closest thing to a primary source. Treated as estimates and flagged as such.',
  },
  {
    tier: 'Tier 4 — Community and user reports',
    examples:
      'Owner forums, importer discussion groups, social posts, and reader correspondence.',
    use: 'Used only to find a lead worth checking. Never the sole basis for a factual claim, a price, or a recommendation.',
  },
];

const priceTypes = [
  {
    label: 'Official MSRP',
    meaning: 'The manufacturer\u2019s official recommended retail price for a stated market.',
  },
  {
    label: 'China market reference price',
    meaning: 'A Chinese-market transaction or reference price, distinct from the factory gate.',
  },
  {
    label: 'China ex-factory reference price',
    meaning:
      'The starting price at the Chinese factory gate. This is the basis this catalog uses by default; it is not a retail, FOB, or landed price.',
  },
  {
    label: 'FOB quotation',
    meaning: 'A free-on-board price at an origin port, including domestic freight and port charges.',
  },
  {
    label: 'Landed cost estimate',
    meaning: 'A destination-market delivered-cost estimate. Not published on this platform; see the sister site.',
  },
];

const rangeStandards = [
  { label: 'CLTC', meaning: 'China Light-duty vehicle Test Cycle. The standard this catalog uses by default; figures read higher than WLTP/EPA.' },
  { label: 'WLTP', meaning: 'Worldwide Harmonised Light vehicles Test Procedure (EU). Closer to real-world driving than CLTC.' },
  { label: 'EPA', meaning: 'US Environmental Protection Agency cycle. The most conservative of the three.' },
  { label: 'NEDC', meaning: 'New European Driving Cycle. A legacy EU standard, now largely superseded by WLTP.' },
];

const claimLayers = [
  {
    label: 'Fact',
    meaning: 'An established, verifiable statement traceable to a Tier-1 source (regulation, official datasheet, type-approval database).',
  },
  {
    label: 'Manufacturer claim',
    meaning: 'A figure or statement the manufacturer asserts — such as a published range or feature — that we have not independently re-measured.',
  },
  {
    label: 'Editorial interpretation',
    meaning: 'Our own analysis and judgement: context, trade-offs, and explanation of what the numbers mean.',
  },
  {
    label: 'Estimate',
    meaning: 'A derived or benchmark figure from a documented formula or industry benchmark, not a measured or quoted value.',
  },
];

const rules = [
  {
    title: 'First-hand knowledge is labelled as perspective',
    body: `When ${company.author}'s production-side experience informs an analysis — why a cell chemistry choice shows up in pack cost, why a supplier relationship matters to output — we say that is where the judgement comes from. It is context and interpretation, not a measured result.`,
  },
  {
    title: 'One company\u2019s experience is not a fact about a whole market',
    body: `Chengguang Energy's manufacturing experience is real, and it is one company's view of the battery industry. We do not generalise it into claims about other manufacturers' products, quality, or pricing. A statement about a specific vehicle needs a source about that vehicle.`,
  },
  {
    title: 'No manufactured test results',
    body: 'We do not run battery, range, or safety tests, and we never present one as if we did. Where independent test data is cited, it is attributed to whoever ran the test.',
  },
  {
    title: 'Estimates say they are estimates',
    body: 'Derived and benchmark figures are marked as estimates with their basis shown, never presented as quotes or measured results.',
  },
  {
    title: 'Conflicting sources are surfaced, not hidden',
    body: 'When two credible sources disagree on a figure, we prefer the higher tier and note the discrepancy rather than silently picking the number that reads better.',
  },
  {
    title: 'Freshness is part of accuracy',
    body: 'Prices, specifications, and regulations change. Each record and page carries the date it was last checked, so a stale figure is visible as stale rather than passing as current.',
  },
];
---

<MarketingLayout
  title="Data & Editorial Methodology — Sources, Prices, Range Standards, and Review"
  description="How China EV Mart sources and updates data, defines price bases and range standards, separates facts from claims and estimates, and runs its editorial review."
>
  <article class="max-w-3xl mx-auto px-6 py-16">
    <div class="mb-10">
      <a href="/" class="text-sm text-gray-600 hover:text-green-600">← Back to home</a>
    </div>

    <h1 class="text-4xl font-bold mb-3">Data &amp; Editorial Methodology</h1>
    <p class="text-gray-600 mb-10">
      How we source and update data, what our price and range figures mean, how we separate fact
      from claim and estimate, and how editorial review works.
    </p>

    <div class="prose max-w-none space-y-8">
      <section>
        <h2 class="text-2xl font-bold mb-3">The problem this page solves</h2>
        <p>
          China EV Mart is written by someone with genuine manufacturing-side experience in automotive
          batteries, published by a company that works in that industry. That is useful — it is why
          some of our analysis reads differently from a page assembled purely from search results.
        </p>
        <p>
          It is also a risk. Experience is easy to overstate, and an industry background can quietly
          turn into claims about products and companies we have never tested. This page is the rule
          we hold ourselves to: first-hand knowledge is used as perspective and clearly labelled;
          facts rest on evidence a reader can check.
        </p>
      </section>

      <section>
        <h2 class="text-2xl font-bold mb-3">Two kinds of knowledge, kept apart</h2>
        <div class="not-prose grid gap-6 sm:grid-cols-2">
          <div class="rounded-lg border border-gray-200 p-5">
            <p class="font-semibold text-gray-900 mb-2">First-party industry knowledge</p>
            <p class="text-sm text-gray-700">
              What comes from working inside battery production and the Chinese EV supply chain:
              how cost structures form, where supply constraints appear, why a spec sheet does not
              tell the whole story.
            </p>
            <p class="text-sm text-gray-600 mt-3">
              Used for: interpretation, context, and explaining the "why" behind a public number.
            </p>
          </div>
          <div class="rounded-lg border border-gray-200 p-5">
            <p class="font-semibold text-gray-900 mb-2">Verifiable public evidence</p>
            <p class="text-sm text-gray-700">
              Documents and data anyone can check: regulations, tariffs, tax rates, type approvals,
              manufacturer datasheets, published market data.
            </p>
            <p class="text-sm text-gray-600 mt-3">
              Used for: every figure and factual claim we state as fact, with the source named.
            </p>
          </div>
        </div>
        <p>
          The dividing line is simple: <strong>if a reader could not check it, it does not appear as
          a fact.</strong> It appears as analysis, clearly marked as such.
        </p>
      </section>

      <section>
        <h2 class="text-2xl font-bold mb-3">Four layers of a statement</h2>
        <p>
          Every substantive claim on a vehicle, brand, or technology page falls into one of four
          layers. The layer is the reader's shortcut for how much to trust a statement.
        </p>
        <div class="not-prose space-y-4">
          {claimLayers.map((l) => (
            <div class="rounded-lg border border-gray-200 p-5">
              <p class="font-semibold text-gray-900 mb-1">
                <span class="text-green-700 mr-2">{l.label}</span>
              </p>
              <p class="text-sm text-gray-700">{l.meaning}</p>
            </div>
          ))}
        </div>
        <p>
          Facts carry a source; manufacturer claims are attributed to the manufacturer rather than
          stated as our finding; editorial interpretation is written in a voice that says it is
          judgement; estimates are labelled as estimates with their basis shown.
        </p>
      </section>

      <section>
        <h2 class="text-2xl font-bold mb-3">Data sources</h2>
        <p>
          Sources are graded so that a claim's strength matches the evidence behind it. Tier 1 is the
          standard for facts; lower tiers carry correspondingly more caution.
        </p>
        <div class="not-prose space-y-4">
          {tiers.map((t, i) => (
            <div class="rounded-lg border border-gray-200 p-5">
              <p class="font-semibold text-gray-900 mb-2">
                <span class="text-green-700 mr-2">{`0${i + 1}`}</span>{t.tier}
              </p>
              <p class="text-sm text-gray-700 mb-2">
                <span class="font-medium text-gray-900">Examples:</span> {t.examples}
              </p>
              <p class="text-sm text-gray-700">
                <span class="font-medium text-gray-900">How we use it:</span> {t.use}
              </p>
            </div>
          ))}
        </div>
        <p>
          Record-level provenance — the source type, confidence, and update date attached to each
          vehicle record — is documented on the{' '}
          <a href="/docs/data-provenance/" class="text-green-700 hover:underline">Data Provenance</a> page.
        </p>
      </section>

      <section>
        <h2 class="text-2xl font-bold mb-3">Update frequency</h2>
        <p>
          We review records and pages periodically rather than on a fixed schedule. Each vehicle
          record carries a <code>data_updated</code> date, and each page carries a last-updated date,
          so a figure's age is visible rather than hidden. Tariff and price data is revisited most
          often, since those move fastest. If you spot a stale figure, report it via the contact
          channel — corrections are welcomed.
        </p>
      </section>

      <section>
        <h2 class="text-2xl font-bold mb-3">Correction process</h2>
        <p>
          When we get something wrong, we fix it and note the change. Material corrections to a
          dated figure or a factual claim are recorded on the page rather than silently swapped out.
          To report an error, email{' '}
          <a href={`mailto:${company.email}`} class="text-green-700 hover:underline">{company.email}</a>.
          The same process is described on the{' '}
          <a href="/editorial-independence" class="text-green-700 hover:underline">Editorial Independence</a>{' '}
          page.
        </p>
      </section>

      <section>
        <h2 class="text-2xl font-bold mb-3">Price definitions</h2>
        <p>
          A price is meaningless without its basis. We keep five price bases strictly separate and
          label each figure with the one it actually is — never silently substituting one for
          another.
        </p>
        <div class="not-prose space-y-4">
          {priceTypes.map((p) => (
            <div class="rounded-lg border border-gray-200 p-5">
              <p class="font-semibold text-gray-900 mb-1">{p.label}</p>
              <p class="text-sm text-gray-700">{p.meaning}</p>
            </div>
          ))}
        </div>
        <p class="text-sm text-gray-600">
          This catalog uses <strong>China ex-factory reference price</strong> as its default basis,
          as documented on each vehicle record. It is a factory-gate starting price — not a retail,
          FOB, or landed price. A reader comparing figures should confirm the actual quotation with
          the supplier; we do not publish transactional prices or quotes.
        </p>
      </section>

      <section>
        <h2 class="text-2xl font-bold mb-3">Range standards</h2>
        <p>
          Range is the output of a specific test procedure, not a fixed property of a car. We record
          range against the standard it was measured under and never compare figures across
          standards without normalising.
        </p>
        <div class="not-prose space-y-4">
          {rangeStandards.map((r) => (
            <div class="rounded-lg border border-gray-200 p-5">
              <p class="font-semibold text-gray-900 mb-1">{r.label}</p>
              <p class="text-sm text-gray-700">{r.meaning}</p>
            </div>
          ))}
        </div>
        <p class="text-sm text-gray-600">
          CLTC figures run systematically higher than WLTP and EPA for the same vehicle. When a
          figure's standard is not stated, we mark it as not recorded rather than guessing. See the{' '}
          <a href="/blog/cltc-vs-wltp-range/" class="text-green-700 hover:underline">CLTC vs WLTP</a> guide.
        </p>
      </section>

      <section>
        <h2 class="text-2xl font-bold mb-3">Editorial review</h2>
        <p>
          Substantive pages carry a four-part attribution block — written by, reviewed by, data
          verified by, and last updated. {company.author} writes the analysis and is the named author
          on those pages. Where a page is written and reviewed by the same person, the attribution
          says so; we do not manufacture a second name to look more institutional than we are. The
          full byline system is on the{' '}
          <a href="/authors" class="text-green-700 hover:underline">Authors &amp; Review Standards</a>{' '}
          page.
        </p>
      </section>

      <section>
        <h2 class="text-2xl font-bold mb-3">Cost assumptions</h2>
        <p>
          This platform does not publish a landed-cost calculator or per-destination delivered-cost
          figures. Landed-cost estimation — import duty, countervailing duty, VAT, freight,
          certification, and registration — lives on our sister site,{' '}
          <a href="https://electricvehiclehub.net/landed-cost-calculator/" class="text-green-700 hover:underline" rel="noopener">
            electricvehiclehub.net
          </a>
          , where the formula and its assumptions are documented in full. Because no calculator
          runs on this platform, we publish no calculator assumptions here.
        </p>
      </section>

      <section>
        <h2 class="text-2xl font-bold mb-3">Comparison standards</h2>
        <p>
          Comparison content on this platform is hand-curated, not machine-generated, and compares
          only figures that are actually comparable: the same price basis, the same range standard,
          or explicitly labelled different trims, model years, markets, and test cycles. Each
          comparison names its basis and states the source and date behind important figures. Where
          two entries differ in a material way — different trim, different market, different test
          standard — the difference is labelled rather than silently equated. We do not auto-generate
          large matrices of comparison URLs.
        </p>
      </section>

      <section>
        <h2 class="text-2xl font-bold mb-3">Rules we apply</h2>
        <div class="not-prose space-y-4">
          {rules.map((r) => (
            <div class="border-l-4 border-green-600 pl-4">
              <p class="font-semibold text-gray-900 mb-1">{r.title}</p>
              <p class="text-sm text-gray-700">{r.body}</p>
            </div>
          ))}
        </div>
      </section>

      <section>
        <h2 class="text-2xl font-bold mb-3">Limits of this method</h2>
        <ul class="list-disc pl-6 space-y-2">
          <li>
            Not every market or figure has a Tier 1 source. Where only Tier 2 or 3 evidence exists,
            our figures are correspondingly softer and are presented as estimates.
          </li>
          <li>
            Sources go out of date. We date-stamp records and pages and revise them, but a page can
            be accurate when written and stale when you read it.
          </li>
          <li>
            We are not an audit body. We verify against the best available public evidence; we do not
            independently inspect factories, vehicles, or accounts.
          </li>
        </ul>
      </section>

      <section>
        <h2 class="text-2xl font-bold mb-3">Related policies</h2>
        <ul class="list-disc pl-6 space-y-2">
          <li>
            <a href="/editorial-independence" class="text-green-700 hover:underline">
              Editorial Independence Policy
            </a>{' '}
            — ownership, editorial control, and disclosure.
          </li>
          <li>
            <a href="/authors" class="text-green-700 hover:underline">Authors &amp; Review Standards</a>{' '}
            — who writes and reviews, and what each byline means.
          </li>
          <li>
            <a href="/docs/data-provenance/" class="text-green-700 hover:underline">Data Provenance</a>{' '}
            — field-level source and confidence conventions.
          </li>
          <li>
            <a href="/disclaimer" class="text-green-700 hover:underline">Disclaimer</a> — the limits
            of what this site can tell you.
          </li>
        </ul>
      </section>

      <section class="border-t border-gray-200 pt-8 text-sm text-gray-600">
        <p>
          Published by <strong>{company.name}</strong> · {company.legalName}
          <br/>Author: <strong>{company.author}</strong>, {company.authorRole}
          <br/>Last updated: {lastUpdated}
        </p>
      </section>
    </div>
  </article>
</MarketingLayout>
