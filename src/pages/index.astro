---
import { getCollection } from 'astro:content';
import MarketingLayout from '@/layouts/MarketingLayout.astro';
import VehicleSearch from '@/components/VehicleSearch.astro';
import { siteConfig } from '@/config';
import { getSiteStats } from '@/lib/site-stats';
import { brandLabelMap } from '@/lib/brand-label';
import { POWERTRAIN_ORDER, powertrainLabel } from '@/lib/powertrain';

const siteStats = await getSiteStats();
const vehicles = await getCollection('vehicles');
const brands = await getCollection('brands');
const brandMap = await brandLabelMap();
vehicles.sort((a, b) => a.data.price_usd - b.data.price_usd);

// 公开计数从规范化数据集实时推导（P3 单一数据源），不硬编码
const vehicleCount = vehicles.length; // 517
const brandCount = brands.length; // 72
const tierACount = vehicles.filter((v) => v.data.quality_tier === 'A').length; // 433

// Dataset JSON-LD — product database (规格/版本/技术)，非 landed-cost
const updatedDates = vehicles
  .map((v) => v.data.data_updated)
  .filter(Boolean)
  .sort();
const temporalCoverage = updatedDates.length
  ? `${updatedDates[0]}/${updatedDates[updatedDates.length - 1]}`
  : '2025-01-01/2026-12-31';
const datasetJsonLd = {
  '@context': 'https://schema.org',
  '@type': 'Dataset',
  name: 'Chinese New-Energy Vehicle Product Database',
  description: `Machine-readable product database of Chinese new-energy vehicles — specifications, powertrain, dimensions, and technology data across ${brandCount} brands. Prices are China ex-factory reference prices; range figures are labelled by test standard.`,
  url: `${siteConfig.url}/`,
  creator: {
    '@type': 'Organization',
    name: 'Chengguang Energy',
    legalName: 'Jinzhou Chengguang Power Source Co., Ltd.',
    url: siteConfig.url,
  },
  license: 'https://creativecommons.org/licenses/by/4.0/',
  temporalCoverage,
  dateModified: new Date().toISOString().split('T')[0],
  isAccessibleForFree: true,
  variableMeasured: [
    { '@type': 'PropertyValue', name: 'price_usd', description: 'China ex-factory reference price in USD' },
    { '@type': 'PropertyValue', name: 'powertrain', description: 'Powertrain type (BEV / PHEV / EREV / HEV / ICE)' },
    { '@type': 'PropertyValue', name: 'range_cltc_km', description: 'CLTC range in km' },
    { '@type': 'PropertyValue', name: 'battery_kwh', description: 'Battery capacity in kWh' },
    { '@type': 'PropertyValue', name: 'battery_type', description: 'Battery chemistry (LFP / NMC / etc.)' },
    { '@type': 'PropertyValue', name: 'motor_power_kw', description: 'Motor power in kW' },
    { '@type': 'PropertyValue', name: 'trim', description: 'Available trim / version variants' },
  ],
};

// 精选车型：仅数据完整度达标（quality_tier = A），无达标项不硬凑
const featuredVehicles = vehicles
  .filter((v) => v.data.quality_tier === 'A')
  .sort((a, b) => b.data.price_usd - a.data.price_usd)
  .slice(0, 6);

// 品牌浏览：从品牌集合实时推导（替代硬编码数组，P2-4）
const brandNames = brands
  .map((b) => b.data.brand_name)
  .sort((a, b) => a.localeCompare(b));

// 车型发现数据（客户端过滤用）：品牌/车身类型/动力/价格带
const discoveryItems = vehicles.map((v) => ({
  slug: v.data.slug,
  title: v.data.title,
  brand: brandMap.get(v.data.brand) || v.data.brand,
  type: v.data.type,
  powertrain: v.data.powertrain,
  price: v.data.price_usd,
  range: v.data.range_cltc_km,
  battery: v.data.battery_kwh,
}));
const discoveryJson = JSON.stringify(discoveryItems).replace(/</g, '\\u003c');

// 动力形式：按规范枚举顺序（BEV/PHEV/EREV/HEV/ICE），仅呈现数据中存在的
const powertrains = POWERTRAIN_ORDER.filter((p) => vehicles.some((v) => v.data.powertrain === p));
// 车身类型：仅呈现数据中存在的（13 类枚举，当前 4 类有值）
const bodyTypes = [...new Set(vehicles.map((v) => v.data.type))].sort();
---

<MarketingLayout
  title={`${siteConfig.name} — Chinese New-Energy Vehicle Database`}
  description={`${siteConfig.description} ${vehicleCount} vehicles across ${brandCount} brands, with ex-factory reference prices and range figures labelled by test standard.`}
>
  <!-- HERO：定位句（P2 规范）+ 车型发现主入口 -->
  <section class="relative overflow-hidden px-6 py-24 md:py-28 text-center">
    <div class="absolute inset-0 bg-gradient-to-b from-green-100/60 via-transparent to-transparent pointer-events-none"></div>
    <div class="relative mx-auto max-w-4xl">
      <span class="inline-block px-4 py-1.5 bg-green-600/10 text-green-600 rounded-full text-sm font-medium mb-6">
        Independent information platform
      </span>
      <h1 class="text-4xl md:text-6xl font-bold tracking-tight mb-6">
        Discover Chinese <span class="text-green-600">new-energy vehicles</span> by the data
      </h1>
      <p class="text-lg md:text-xl text-gray-600 max-w-2xl mx-auto mb-10">
        {siteConfig.description}
      </p>
      <div class="mb-8">
        <VehicleSearch />
      </div>
      <div class="flex flex-col sm:flex-row gap-4 justify-center">
        <a href="/vehicles/" class="inline-flex items-center justify-center px-8 py-3 rounded-lg bg-green-600 hover:bg-green-500 text-white font-semibold transition">
          Browse {vehicleCount} vehicles →
        </a>
        <a href="/brands/" class="inline-flex items-center justify-center px-8 py-3 rounded-lg border border-gray-300 hover:border-gray-500 text-gray-800 font-semibold transition">
          Explore {brandCount} brands
        </a>
      </div>
    </div>
  </section>

  <!-- 车型发现：品牌-动力-车身-价格带 筛选（客户端过滤，无索引 URL） -->
  <section class="px-6 py-14">
    <div class="mx-auto max-w-6xl">
      <div class="text-center mb-10">
        <h2 class="text-3xl md:text-4xl font-bold mb-3">Find a vehicle</h2>
        <p class="text-gray-600 max-w-2xl mx-auto">
          Filter the catalog by powertrain, body type, brand, and price band. Filtering runs
          in your browser — it does not create new pages or URLs.
        </p>
      </div>

      <div id="discovery-root" class="space-y-6">
        <!-- 筛选 chips -->
        <div class="space-y-3">
          <div class="flex flex-wrap items-center gap-2 justify-center">
            <span class="text-sm font-semibold text-gray-500 uppercase tracking-wide mr-1">Powertrain</span>
            <button data-filter="powertrain" data-value="all" class="chip active">All</button>
            {powertrains.map((p) => (
              <button data-filter="powertrain" data-value={p} class="chip" title={powertrainLabel(p)}>{p}</button>
            ))}
          </div>
          <div class="flex flex-wrap items-center gap-2 justify-center">
            <span class="text-sm font-semibold text-gray-500 uppercase tracking-wide mr-1">Body type</span>
            <button data-filter="type" data-value="all" class="chip active">All</button>
            {bodyTypes.map((t) => (
              <button data-filter="type" data-value={t} class="chip">{t}</button>
            ))}
          </div>
          <div class="flex flex-wrap items-center gap-2 justify-center">
            <span class="text-sm font-semibold text-gray-500 uppercase tracking-wide mr-1">Price</span>
            <button data-filter="price" data-value="all" class="chip active">All</button>
            <button data-filter="price" data-value="0-10000" class="chip">Under $10k</button>
            <button data-filter="price" data-value="10000-20000" class="chip">$10k–20k</button>
            <button data-filter="price" data-value="20000-30000" class="chip">$20k–30k</button>
            <button data-filter="price" data-value="30000-999999" class="chip">$30k+</button>
          </div>
          <div class="flex flex-wrap items-center gap-2 justify-center">
            <span class="text-sm font-semibold text-gray-500 uppercase tracking-wide mr-1">Brand</span>
            <select id="brand-select" class="bg-white border border-gray-300 rounded-lg px-3 py-2 text-sm text-gray-800 focus:border-green-500 focus:ring-2 focus:ring-green-200 outline-none">
              <option value="all">All brands</option>
              {[...new Set(discoveryItems.map((d) => d.brand))].sort().map((b) => (
                <option value={b}>{b}</option>
              ))}
            </select>
          </div>
          <p class="text-xs text-gray-400 text-center pt-1">
            Powertrain key: BEV = battery electric · PHEV = plug-in hybrid · EREV = extended-range electric ·
            HEV = non-plug-in hybrid · ICE = internal combustion. Prices are China ex-factory reference
            prices (USD), not retail or landed prices.
          </p>
        </div>

        <!-- 结果 -->
        <div id="discovery-results" class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-3 gap-5"></div>
        <div class="text-center">
          <a href="/vehicles/" class="inline-flex items-center px-6 py-3 rounded-lg border border-gray-300 hover:border-gray-500 text-gray-800 font-medium transition">
            View all {vehicleCount} vehicles →
          </a>
        </div>
      </div>
    </div>
  </section>

  <!-- 精选车型：仅 quality_tier = A（数据完整度达标） -->
  <section class="px-6 py-16 bg-gray-50">
    <div class="mx-auto max-w-6xl">
      <div class="text-center mb-12">
        <h2 class="text-3xl md:text-4xl font-bold mb-3">Featured vehicles</h2>
        <p class="text-gray-600 max-w-2xl mx-auto">
          A selection from the {tierACount} records that meet our A-tier data-completeness bar —
          battery chemistry, drive architecture, motor type, and charging interface all catalogued.
        </p>
      </div>
      <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-3 gap-5">
        {featuredVehicles.map((v) => (
          <a href={`/vehicles/${v.data.slug}/`} class="block p-6 rounded-xl border border-gray-200 bg-white hover:border-green-600/50 transition group">
            <div class="flex items-center justify-between mb-4">
              <span class="px-2.5 py-1 bg-green-600/10 text-green-600 rounded text-xs font-medium">{brandMap.get(v.data.brand) || v.data.brand.toUpperCase()}</span>
              <span class="text-xs text-gray-600">{v.data.type} · {v.data.powertrain}</span>
            </div>
            <h3 class="text-xl font-bold mb-1 group-hover:text-green-600 transition">{v.data.title}</h3>
            <div class="flex items-baseline gap-2 mb-3">
              <span class="text-2xl font-bold">${v.data.price_usd.toLocaleString()}</span>
              <span class="text-xs text-gray-600">ex-factory reference</span>
            </div>
            <div class="text-sm text-gray-600 mb-4 space-y-1">
              {v.data.range_cltc_km && <div><span class="text-gray-500">Range:</span> {v.data.range_cltc_km} km CLTC</div>}
              {v.data.battery_kwh && <div><span class="text-gray-500">Battery:</span> {v.data.battery_kwh} kWh</div>}
              {v.data.battery_type && <div><span class="text-gray-500">Chemistry:</span> {v.data.battery_type}</div>}
              {v.data.motor_power_kw && <div><span class="text-gray-500">Power:</span> {v.data.motor_power_kw} kW</div>}
            </div>
            <span class="text-sm font-semibold text-green-600 group-hover:underline">View full profile →</span>
          </a>
        ))}
      </div>
      {featuredVehicles.length === 0 && (
        <p class="text-center text-gray-500 text-sm">No vehicles currently meet the A-tier completeness bar.</p>
      )}
    </div>
  </section>

  <!-- 入口：品牌浏览 / 对比 / 技术专题 / 出口指南 -->
  <section class="px-6 py-16">
    <div class="mx-auto max-w-6xl">
      <div class="text-center mb-12">
        <h2 class="text-3xl md:text-4xl font-bold mb-3">Explore further</h2>
        <p class="text-gray-600 max-w-2xl mx-auto">
          Browse by brand, compare models, dig into the technology, or evaluate export-market
          requirements.
        </p>
      </div>
      <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-4 gap-5">
        <a href="/brands/" class="block p-6 rounded-xl border border-gray-200 hover:border-green-600/50 transition group">
          <h3 class="text-lg font-bold mb-2 group-hover:text-green-600 transition">Browse brands</h3>
          <p class="text-sm text-gray-600">All {brandCount} brands with parent manufacturers and model lineups.</p>
        </a>
        <a href="/blog/tag/comparison/" class="block p-6 rounded-xl border border-gray-200 hover:border-green-600/50 transition group">
          <h3 class="text-lg font-bold mb-2 group-hover:text-green-600 transition">Compare models</h3>
          <p class="text-sm text-gray-600">Head-to-head comparisons across specifications, trims, and price classes.</p>
        </a>
        <a href="/docs/glossary/" class="block p-6 rounded-xl border border-gray-200 hover:border-green-600/50 transition group">
          <h3 class="text-lg font-bold mb-2 group-hover:text-green-600 transition">Technology explained</h3>
          <p class="text-sm text-gray-600">Battery chemistry, motor types, drive architecture, and charging standards.</p>
        </a>
        <a href="https://electricvehiclehub.net/" rel="noopener" target="_blank" class="block p-6 rounded-xl border border-gray-200 hover:border-green-600/50 transition group">
          <h3 class="text-lg font-bold mb-2 group-hover:text-green-600 transition">Export-market guides ↗</h3>
          <p class="text-sm text-gray-600">Landed-cost, import-duty, and per-market pricing data on electricvehiclehub.net.</p>
        </a>
      </div>
    </div>
  </section>

  <!-- 产品信息价值（每条记录含什么） -->
  <section class="px-6 py-16 bg-gray-50">
    <div class="mx-auto max-w-6xl">
      <div class="text-center mb-12">
        <h2 class="text-3xl md:text-4xl font-bold mb-3">What's inside every product record</h2>
        <p class="text-gray-600 max-w-2xl mx-auto">
          Each vehicle page is a structured product profile, not a marketing blurb.
        </p>
      </div>
      <div class="grid grid-cols-1 md:grid-cols-3 gap-6">
        <div class="p-6 rounded-xl border border-gray-200 bg-white">
          <div class="text-green-600 text-2xl mb-3">01</div>
          <h3 class="text-lg font-bold mb-2">Specifications</h3>
          <p class="text-gray-600 text-sm">Battery capacity and chemistry, motor power and torque, acceleration, range (CLTC/WLTP), and efficiency — in one normalized table.</p>
        </div>
        <div class="p-6 rounded-xl border border-gray-200 bg-white">
          <div class="text-green-600 text-2xl mb-3">02</div>
          <h3 class="text-lg font-bold mb-2">Versions &amp; trims</h3>
          <p class="text-gray-600 text-sm">Trim and version variants documented where the manufacturer publishes them, so you can compare the lineup, not just a single configuration.</p>
        </div>
        <div class="p-6 rounded-xl border border-gray-200 bg-white">
          <div class="text-green-600 text-2xl mb-3">03</div>
          <h3 class="text-lg font-bold mb-2">Technology &amp; compliance</h3>
          <p class="text-gray-600 text-sm">Battery thermal management, heat pump, charging interface, drive architecture, suspension — plus HS code and certification facts.</p>
        </div>
      </div>
    </div>
  </section>

  <!-- 品牌浏览（动态推导，含计数） -->
  <section class="px-6 py-16">
    <div class="mx-auto max-w-6xl">
      <div class="text-center mb-10">
        <h2 class="text-3xl md:text-4xl font-bold mb-3">{brandCount} Chinese EV brands, one database</h2>
        <p class="text-gray-600 max-w-2xl mx-auto">
          From BYD to Xiaomi, Yangwang to Leapmotor — every brand, with product records for each model.
        </p>
      </div>
      <div class="flex flex-wrap justify-center gap-2">
        {brandNames.map((b) => (
          <span class="px-4 py-2 rounded-lg border border-gray-200 text-gray-600 hover:text-green-600 hover:border-green-600/40 transition cursor-default text-sm">
            {b}
          </span>
        ))}
      </div>
      <div class="text-center mt-8">
        <a href="/brands/" class="text-green-600 hover:text-green-600 text-sm font-medium">Browse all brands →</a>
      </div>
    </div>
  </section>

  <!-- B2B 联系路径：如实呈现现有联系方式 -->
  <section class="px-6 py-20 text-center">
    <div class="mx-auto max-w-3xl">
      <h2 class="text-3xl md:text-5xl font-bold mb-4">Researching at scale? Talk to us</h2>
      <p class="text-gray-600 text-lg mb-8">
        For B2B product-data and specification enquiries, contact Chengguang Energy
        (Jinzhou Chengguang Power Source Co., Ltd.) — an independent information platform, not a
        vehicle seller.
      </p>
      <div class="flex flex-col sm:flex-row gap-4 justify-center">
        <a href="/vehicles/" class="inline-flex items-center justify-center px-8 py-3 rounded-lg bg-green-600 hover:bg-green-500 text-white font-semibold transition">
          Browse the database
        </a>
        <a href="/contact/" class="inline-flex items-center justify-center px-8 py-3 rounded-lg border border-gray-300 hover:border-gray-500 text-gray-800 font-semibold transition">
          Contact us
        </a>
      </div>
    </div>
  </section>

  <script type="application/ld+json" set:html={JSON.stringify(datasetJsonLd)} />
</MarketingLayout>

<style>
  .chip {
    padding: 0.375rem 0.875rem;
    border-radius: 9999px;
    border: 1px solid #e5e7eb;
    color: #4b5563;
    font-size: 0.8125rem;
    font-weight: 500;
    transition: all 0.15s ease;
  }
  .chip:hover {
    border-color: #16a34a;
    color: #16a34a;
  }
  .chip.active {
    background: #16a34a;
    border-color: #16a34a;
    color: #fff;
  }
</style>

<script>
  const ROOT = document.getElementById('discovery-root');
  const ITEMS = JSON.parse(document.getElementById('discovery-data').textContent);
  const RESULTS = document.getElementById('discovery-results');
  const BRAND_SELECT = document.getElementById('brand-select');

  const state = { powertrain: 'all', type: 'all', price: 'all', brand: 'all' };

  function esc(s) {
    return String(s).replace(/&/g, '&amp;').replace(/</g, '&lt;').replace(/>/g, '&gt;').replace(/"/g, '&quot;');
  }

  function priceInBand(p, band) {
    if (band === 'all') return true;
    const [lo, hi] = band.split('-').map(Number);
    return p >= lo && p < hi;
  }

  function render() {
    const matches = ITEMS.filter((it) =>
      (state.powertrain === 'all' || it.powertrain === state.powertrain) &&
      (state.type === 'all' || it.type === state.type) &&
      priceInBand(it.price, state.price) &&
      (state.brand === 'all' || it.brand === state.brand)
    ).slice(0, 12);

    if (!matches.length) {
      RESULTS.innerHTML = '<div class="col-span-full text-center text-gray-500 py-10">No vehicles match these filters.</div>';
      return;
    }
    RESULTS.innerHTML = matches.map((it) => `
      <a href="/vehicles/${esc(it.slug)}/" class="block p-5 rounded-xl border border-gray-200 bg-white hover:border-green-600/50 transition group">
        <div class="flex items-center justify-between mb-2">
          <span class="px-2 py-0.5 bg-green-600/10 text-green-600 rounded text-xs font-medium">${esc(it.brand)}</span>
          <span class="text-xs text-gray-600">${esc(it.type)} · ${esc(it.powertrain)}</span>
        </div>
        <h3 class="font-bold text-gray-900 group-hover:text-green-600 transition">${esc(it.title)}</h3>
        <div class="mt-1 text-sm text-gray-600">
          <span class="font-bold text-gray-900">$${it.price.toLocaleString()}</span>
          ${it.range ? `<span class="ml-2">· ${it.range} km</span>` : ''}
          ${it.battery ? `<span class="ml-2">· ${it.battery} kWh</span>` : ''}
        </div>
      </a>
    `).join('');
  }

  ROOT.querySelectorAll('button.chip').forEach((btn) => {
    btn.addEventListener('click', () => {
      const filter = btn.dataset.filter;
      const value = btn.dataset.value;
      state[filter] = value;
      ROOT.querySelectorAll(`button.chip[data-filter="${filter}"]`).forEach((b) => b.classList.remove('active'));
      btn.classList.add('active');
      render();
    });
  });

  BRAND_SELECT.addEventListener('change', () => {
    state.brand = BRAND_SELECT.value;
    render();
  });

  render();
</script>

<script type="application/json" id="discovery-data" set:html={discoveryJson} />
